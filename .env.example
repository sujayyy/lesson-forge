# Export these variables in your shell. The app does not auto-load .env files.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
# Choose chat-completions models that support JSON object output.
GENERATOR_MODEL=
EVALUATOR_MODEL=
# Optional free-tier pacing and smaller output budget.
LLM_MIN_INTERVAL_SECONDS=0
LLM_MAX_COMPLETION_TOKENS=6000
